# Put your event OpenAI API key here. Never commit .env.
OPENAI_API_KEY=
MYELIN_MODEL=gpt-6-astra
# Optional event gateway; blank uses the official API.
OPENAI_BASE_URL=
MYELIN_CRM_URL=http://localhost:8101
MYELIN_EXPENSE_URL=http://localhost:8102
MYELIN_CONSOLE_PORT=8100
MYELIN_RUNS_DIR=runs
# Set to 1 to enable live model calls.
MYELIN_LIVE=0
# Use 0 to open each isolated browser; the console shows captured steps in either mode.
MYELIN_HEADLESS=1
MYELIN_MAX_MODEL_TURNS=20
MYELIN_MAX_ACTIONS=80
MYELIN_ACTION_TIMEOUT_MS=15000
MYELIN_RUN_TIMEOUT_S=180
MYELIN_REPAIR_ATTEMPTS=2
MYELIN_GATE_CONCURRENCY=2
MYELIN_MAX_MODEL_USD_PER_RUN=10
# Synthetic local credentials. No real customer data.
MYELIN_DEMO_EMAIL=demo@myelin.local
MYELIN_DEMO_PASSWORD=myelin-demo
MYELIN_DEMO_TOKEN=replace-with-local-random-token
